# Environment files
.dev.vars

# Worktrees
.worktrees

# System files
.DS_Store
Thumbs.db
.agent
.agents
.angular
.codex
.gemini

# Agent harness：設定與 hook 進版控（換一台機器才有東西可用），
# 個人覆寫與 vendored skills 不進。邏輯本體在 tools/agent-harness/，本來就進版控。
.claude/*
!.claude/settings.json
!.claude/settings.md
!.claude/hooks/
!.claude/agents/

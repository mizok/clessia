{
  "name": "clessia",
  "version": "0.0.0",
  "scripts": {
    "dev": "nx run-many -t serve -p web api",
    "dev:web": "nx serve web",
    "dev:api": "nx serve api",
    "build": "nx run-many -t build",
    "build:web": "nx build web --configuration=production",
    "build:api": "nx build api",
    "test": "nx run-many -t test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "harness": "node tools/agent-harness/check-harness.mjs && node tools/agent-harness/feature-map.mjs",
    "harness:write": "node tools/agent-harness/check-harness.mjs --write && node tools/agent-harness/feature-map.mjs --write",
    "harness:test": "node --test 'tools/agent-harness/**/*.test.mjs'",
    "test:baseline": "npx nx affected -t test --base=main 2>&1 | node tools/agent-harness/test-gate.mjs --write",
    "bootstrap": "tsx apps/api/src/scripts/bootstrap-org.ts",
    "login-link": "tsx apps/api/src/scripts/login-link.ts"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@10.9.3",
  "dependencies": {
    "@angular/animations": "^21.1.3",
    "@angular/cdk": "^21.1.3",
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/platform-browser": "^21.1.0",
    "@angular/router": "^21.1.0",
    "@hono/swagger-ui": "^0.5.3",
    "@hono/zod-openapi": "^1.2.1",
    "@hono/zod-validator": "^0.7.6",
    "@neondatabase/serverless": "^1.0.2",
    "@primeuix/themes": "^2.0.3",
    "@supabase/supabase-js": "^2.95.3",
    "angularx-qrcode": "^21.0.5",
    "better-auth": "1.5.5",
    "date-fns": "^4.1.0",
    "hono": "^4.11.9",
    "jdenticon": "^3.3.0",
    "primeicons": "^7.0.0",
    "primeng": "^21.1.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@angular-devkit/core": "^21.1.3",
    "@angular-devkit/schematics": "^21.1.3",
    "@angular/build": "^21.1.3",
    "@angular/cli": "^21.1.3",
    "@angular/compiler-cli": "^21.1.0",
    "@cloudflare/workers-types": "^5.20260829.1",
    "@nx/angular": "22.5.0",
    "@nx/workspace": "22.5.0",
    "@schematics/angular": "^21.1.3",
    "exceljs": "^4.4.0",
    "jsdom": "^27.1.0",
    "nx": "^22.5.0",
    "tsx": "^4.23.12",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8",
    "wrangler": "^4.127.1"
  }
}

{
  "$comment": "Prompt keyword → existing kb/ pointers. Advisory only: never blocks, silent when nothing matches. Points at kb/, the project's only documentation tree — no parallel doc/ or docs/ (clause c9).",
  "rules": [
    {
      "match": "migration|schema|資料表|欄位|supabase|sql",
      "hints": [
        "kb/wiki/architecture/constitution.md → c3（已提交的 migration 不可修改）、c2（ba_* 表）",
        "supabase/migrations/ 的既有檔案是命名與風格範本"
      ]
    },
    {
      "match": "報名|enrollment|招生",
      "hints": [
        "kb/wiki/rules/ 的 enrollment 規則",
        "kb/wiki/specs/ 對應功能規格",
        "apps/api/src/routes/enrollments/"
      ]
    },
    {
      "match": "出勤|請假|點名|attendance|leave|checkin|簽到",
      "hints": [
        "kb/wiki/flows/ 對應流程圖",
        "apps/api/src/routes/attendance.ts、leaves.ts、daily-checkins.ts"
      ]
    },
    {
      "match": "成績|考試|exam|score|grade",
      "hints": [
        "apps/api/src/routes/academy-exams.ts、school-exams.ts、scores.ts",
        "apps/web/src/app/features/admin/pages/grades/"
      ]
    },
    {
      "match": "權限|角色|role|permission|rbac|登入|auth",
      "hints": [
        "AGENTS.md → 角色架構（單一 ShellLayoutComponent + user_roles.permissions）",
        "apps/web/src/app/core/permission.guard.ts、role.guard.ts",
        "apps/api/src/middleware/auth.ts"
      ]
    },
    {
      "match": "scss|樣式|bem|排版|design token|stylesheet|\\bcss\\b",
      "hints": [
        "kb/wiki/architecture/constitution.md → c6（禁 viewport 單位）",
        "先 invoke angular-scss-bem-standards skill",
        "全域 design tokens：apps/web/src/styles.scss"
      ]
    },
    {
      "match": "架構|architecture|重構|refactor|分層",
      "hints": [
        "kb/wiki/architecture/constitution.md（binding law — 動架構前必讀）",
        "kb/wiki/architecture/constitution-enforcement.md（每條 clause 用什麼機制守）"
      ]
    }
  ]
}
